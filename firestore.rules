rules_version = '2';
// Server-only model. pacteSessions (canonical JSON, owner, phase, deadline),
// access/keys (hashed team credentials), receipts/events (private audit),
// pactePublic and views (filtered projections), pacteCodes and studio documents
// are written only by the trusted backend. Clients use the authenticated API.
// No client creates or updates are allowed, so field validators belong to the
// server transaction boundary; privileged Admin SDK calls bypass these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
