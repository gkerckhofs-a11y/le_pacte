{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Le Pacte — Narrative story import v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario",
    "dilemmas"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "universe",
        "location",
        "year",
        "entry_dilemma",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{2,79}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "universe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "year": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "entry_dilemma": {
          "$ref": "#/$defs/dilemmaId"
        },
        "status": {
          "enum": [
            "prototype",
            "active",
            "archived"
          ]
        },
        "progression": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "initial_dilemmas",
            "finale_id",
            "min_councils",
            "max_councils"
          ],
          "properties": {
            "mode": {
              "const": "hybrid"
            },
            "initial_dilemmas": {
              "type": "array",
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/dilemmaId"
              }
            },
            "finale_id": {
              "$ref": "#/$defs/dilemmaId"
            },
            "min_councils": {
              "type": "integer",
              "minimum": 2,
              "maximum": 50
            },
            "max_councils": {
              "type": "integer",
              "minimum": 2,
              "maximum": 50
            },
            "ending_fragments": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "conditions"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1500
                  },
                  "conditions": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "$ref": "#/$defs/condition"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "dilemmas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/dilemma"
      }
    }
  },
  "$defs": {
    "dilemmaId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{1,39}$"
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indicator",
        "operation"
      ],
      "properties": {
        "indicator": {
          "enum": [
            "economie",
            "securite",
            "satisfaction",
            "bien_etre",
            "developpement",
            "stabilite"
          ]
        },
        "operation": {
          "enum": [
            "delta",
            "toward_center",
            "away_from_center"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": -10,
          "maximum": 10
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "delta"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "toward_center",
                  "away_from_center"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            },
            "properties": {
              "indicator": {
                "const": "stabilite"
              }
            }
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narration",
        "effects",
        "next_id"
      ],
      "properties": {
        "narration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "effects": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "next_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/dilemmaId"
            },
            {
              "type": "null"
            }
          ]
        },
        "chronicle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "alt",
                "credit",
                "license"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://",
                  "maxLength": 2048
                },
                "alt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "credit": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 300
                },
                "license": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 300
                }
              }
            }
          }
        },
        "unlocks": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dilemmaId"
          }
        }
      }
    },
    "dilemma": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "chapter",
        "title",
        "public_text",
        "vote_question",
        "labels",
        "outcomes",
        "image",
        "status",
        "tags"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/dilemmaId"
        },
        "chapter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "public_text": {
          "type": "string",
          "minLength": 10,
          "maxLength": 5000
        },
        "vote_question": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pour",
            "contre"
          ],
          "properties": {
            "pour": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "contre": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            }
          }
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pour",
            "contre"
          ],
          "properties": {
            "pour": {
              "$ref": "#/$defs/outcome"
            },
            "contre": {
              "$ref": "#/$defs/outcome"
            }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "alt",
            "credit",
            "license"
          ],
          "properties": {
            "url": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                {
                  "type": "null"
                }
              ]
            },
            "alt": {
              "type": "string",
              "minLength": 0,
              "maxLength": 300
            },
            "credit": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 300
            },
            "license": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 300
            }
          }
        },
        "status": {
          "enum": [
            "prototype",
            "active",
            "archived"
          ]
        },
        "tags": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "category",
            "priority",
            "conditions"
          ],
          "properties": {
            "category": {
              "enum": [
                "required",
                "optional",
                "finale"
              ]
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "conditions": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "dilemma_id",
            "winner"
          ],
          "properties": {
            "type": {
              "const": "decision"
            },
            "dilemma_id": {
              "$ref": "#/$defs/dilemmaId"
            },
            "winner": {
              "enum": [
                "pour",
                "contre"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "indicator",
            "operator",
            "value"
          ],
          "properties": {
            "type": {
              "const": "indicator"
            },
            "indicator": {
              "enum": [
                "economie",
                "securite",
                "satisfaction",
                "bien_etre",
                "developpement",
                "stabilite"
              ]
            },
            "operator": {
              "enum": [
                "lte",
                "gte",
                "eq"
              ]
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "minimum"
          ],
          "properties": {
            "type": {
              "const": "resolved"
            },
            "minimum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50
            }
          }
        }
      ]
    }
  }
}
