{
  "firestore": {
    "database": "le-pacte",
    "edition": "enterprise",
    "location": "europe-west1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "pacte",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$PROJECT_DIR\" run build:firebase"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ],
  "hosting": {
    "site": "le-pacte-ludificateur",
    "public": "dist/public",
    "predeploy": [
      "npm --prefix \"$PROJECT_DIR\" run build:firebase"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://sheets.googleapis.com; frame-src https://le-pacte-ludificateur.firebaseapp.com https://accounts.google.com; img-src 'self' data: https:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
          }
        ]
      }
    ]
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080,
      "edition": "enterprise"
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Le Pacte — Ludificateur",
        "supportEmail": "gkerckhofs@gmail.com"
      }
    }
  }
}
